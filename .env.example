# Copy to .env (never committed) and fill in the key. Real environment variables win over .env.

# The model every architecture uses, in provider:model form. The default is a local vLLM model;
# also ollama:qwen3:8b, or a paid provider such as openai:gpt-6-luna,
# anthropic:claude-sonnet-5-5 or anthropic:claude-haiku-5-5 with its key.
# APL_MODEL=vllm:qwen3.5-9b
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# The vLLM server (OpenAI-compatible). Its context window is read from the server.
# APL_BASE_URL=http://localhost:8001/v1

# Ollama's context window in tokens (Ollama's own default, 4096, cuts off long episodes).
# APL_NUM_CTX=16384

# Sampling settings; unset means the provider's default. For Ollama, reasoning effort "none"
# turns thinking off. gpt-6-luna honors a temperature only with reasoning effort "none".
# Claude Sonnet 5.5 and Haiku 5.5 reject any non-default temperature. Their effort is low, medium,
# high, xhigh or max; the default is high on Sonnet 5.5 and medium on Haiku 5.5.
# APL_TEMPERATURE=0
# APL_REASONING_EFFORT=medium

# Output tokens per model call; stops a model that thinks endlessly inside one call.
# Default 8192 for vLLM (its context is 32768), 16000 for Claude (thinking counts too),
# 4096 otherwise.
# APL_MAX_OUTPUT_TOKENS=8192

# Tokens (input + output, summed over calls) after which an episode is stopped.
# APL_TOKEN_CAP=2000000

# Provider client retries and per-request timeout in seconds.
# APL_MAX_RETRIES=4
# APL_TIMEOUT_S=300

# Optional prices in USD per 1M tokens, for the dry run's worst-case cost. Set both or neither.
# APL_PRICE_INPUT=0.10
# APL_PRICE_OUTPUT=0.50
# Claude Sonnet 5.5: APL_PRICE_INPUT=2.00, APL_PRICE_OUTPUT=10.00
# Claude Haiku 5.5: APL_PRICE_INPUT=0.10, APL_PRICE_OUTPUT=0.50 (prompts up to 100K tokens;
# 0.50 and 2.50 beyond, which the dry run's estimate does not account for)
